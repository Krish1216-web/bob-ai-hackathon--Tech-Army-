# =============================================================================
# ChainGuard AI — Environment Configuration Template
# IBM BoB AI Innovation Hackathon 2026
# =============================================================================

# Project Metadata
PROJECT_NAME="ChainGuard AI"
API_V1_STR="/api"

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Database Connection
# -----------------------------------------------------------------------------
# PostgreSQL connection string to Supabase pooler or direct connection
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Supabase API Settings (for server-side repository access)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------------------------------------------------------------------
# IBM watsonx.ai Foundation Models Configuration (Optional / Dynamic Fallback)
# -----------------------------------------------------------------------------
WATSONX_API_KEY="your-ibm-watsonx-api-key"
WATSONX_PROJECT_ID="your-ibm-watsonx-project-id"
WATSONX_URL="https://us-south.ml.cloud.ibm.com"

# CORS Configuration
CORS_ORIGINS=["*"]
