# =============================================================================
# ChainGuard AI — Backend Environment Configuration
# =============================================================================

PROJECT_NAME="ChainGuard AI"
API_V1_STR="/api"

# Supabase PostgreSQL Database URI (Primary Authoritative Database)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres"

# Supabase REST Credentials (Service role is backend-only, never sent to browser)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# IBM watsonx.ai Credentials
WATSONX_API_KEY=""
WATSONX_PROJECT_ID=""
WATSONX_URL="https://us-south.ml.cloud.ibm.com"

# CORS
CORS_ORIGINS=["*"]
